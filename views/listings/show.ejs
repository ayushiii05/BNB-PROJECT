<% layout("/layouts/boilerplate")%>
  <div class="row mt-4">
    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
      <!-- Header Section -->
      <div class="mb-4">
        <h1 class="listing-title">
          <%= listing.title %>
        </h1>
        <p class="listing-location"><i class="fa-solid fa-location-dot me-2"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
      </div>

      <!-- Hero Image -->
      <div class="hero-image-container">
        <img src="<%=listing.image%>" class="card-img-top show-img" alt="<%= listing.title %>">
      </div>

      <!-- Main Content -->
      <div class="row mb-5">
        <div class="col-12">
          <h3 class="section-title">About this place</h3>
          <p class="listing-description">
            <%= listing.description %>
          </p>
          <p class="mt-3">
            <span class="price-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></span> <span
              class="text-muted">/ night</span>
            <i class="tax-info text-muted ms-2" style="font-size: 0.9rem;">(+18% GST)</i>
          </p>
          <p class="text-muted">
            <strong>Category:</strong>
            <%= listing.category %>
          </p>

          <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
            <div class="btns mt-4">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn me-3 px-4">Edit</a>
              <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                <button class="btn btn-dark px-4">Delete</button>
              </form>
            </div>
            <% } %>
        </div>
      </div>

      <hr class="mb-5">

      <!-- Reviews Section -->
      <div class="mb-5">
        <% if(currUser) { %>
          <h3 class="section-title">Leave a Review</h3>
          <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation mb-5">
            <div class="mb-3">
              <label for="rating" class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                  aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label">Comments</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control"
                placeholder="Share your experience..." required></textarea>
              <div class="invalid-feedback">Please submit some comments for review</div>
            </div>
            <button class="btn btn-outline-dark px-4">Submit</button>
          </form>
          <% } %>

            <% if(listing.reviews.length> 0) { %>
              <h3 class="section-title mb-4">What guests are saying</h3>
              <div class="row">
                <% for(review of listing.reviews) { %>
                  <div class="col-md-6 mb-4">
                    <div class="review-card h-100">
                      <div class="d-flex align-items-center mb-2">
                        <div class="me-2">
                          <i class="fa-regular fa-user-circle fa-2x text-secondary"></i>
                        </div>
                        <div>
                          <h6 class="mb-0">@JaneDoe</h6>
                          <p class="starability-result" data-rating="<%= review.rating %>"
                            style="transform: scale(0.8); margin-left: -5px;"></p>
                        </div>
                      </div>
                      <p class="card-text text-muted">
                        <%= review.comment %>
                      </p>

                      <form class="mt-2" method="POST"
                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button class="btn btn-sm btn-link text-danger text-decoration-none p-0">Delete</button>
                      </form>
                    </div>
                  </div>
                  <% } %>
              </div>
              <% } %>
      </div>

      <hr class="mb-5">

      <!-- Map Section -->
      <div class="mb-5">
        <h3 class="section-title">Where you'll be</h3>
        <div id="map"></div>
      </div>

      <hr class="mb-5">

      <!-- Booking Widget (Bottom) -->
      <div class="booking-widget mb-5">
        <h4 class="text-center">Ready to explore?</h4>
        <p class="text-center text-muted mb-4">Book your stay at <span class="fw-bold">
            <%= listing.title %>
          </span></p>

        <form action="/listings/<%= listing._id %>/book" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="checkin" class="form-label fw-bold">Check-in</label>
              <input type="date" class="form-control p-3" id="checkin" name="booking[checkIn]" required>
            </div>
            <div class="col-md-6">
              <label for="checkout" class="form-label fw-bold">Check-out</label>
              <input type="date" class="form-control p-3" id="checkout" name="booking[checkOut]" required>
            </div>
            <div class="col-md-6">
              <label for="guests" class="form-label fw-bold">Guests</label>
              <input type="number" class="form-control p-3" id="guests" name="booking[guests]" value="1" min="1"
                required>
            </div>
            <div class="col-md-6">
              <label for="name" class="form-label fw-bold">Full Name</label>
              <input type="text" class="form-control p-3" id="name" name="booking[name]" placeholder="John Doe"
                required>
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label fw-bold">Email</label>
              <input type="email" class="form-control p-3" id="email" name="booking[email]"
                placeholder="john@example.com" required>
            </div>
            <div class="col-md-6">
              <label for="phone" class="form-label fw-bold">Phone</label>
              <input type="tel" class="form-control p-3" id="phone" name="booking[phone]" placeholder="+91 9876543210"
                required>
            </div>
            <div class="col-12 mt-4">
              <button class="btn btn-danger w-100 py-3 fw-bold" style="font-size: 1.1rem;">Reserve Now</button>
            </div>
          </div>
        </form>
        <div class="mt-3 text-center text-muted">
          <small><i class="fa-solid fa-shield-halved me-1"></i> Secure booking. You won't be charged yet.</small>
        </div>
      </div>

    </div>
  </div>

  <script>
    let mapToken = "<%= process.env.MAP_TOKEN %>";
    mapboxgl.accessToken = mapToken;
    const map = new mapboxgl.Map({
      container: "map", // container ID
      style: "mapbox://styles/mapbox/streets-v12", // style URL
      center: [77.209, 28.6139], // starting position [lng, lat]
      zoom: 9, // starting zoom
    });
  </script>